<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      All Files Access. The vault is a folder of plain files under the shared
      Documents volume; we deliberately want real file paths rather than a
      scoped-storage or SAF grant so that writes can be atomic.

      Note: this grant is not obtainable through Play Store review. That is fine
      for a personal, sideloaded build; it would need reworking to ship.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MarkdownNotes">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ViewerActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!--
          One of the three category pages from the top-level menu. Declared
          explicitly because a missing <activity> entry is invisible to both the
          compiler and the unit tests — it only surfaces as an
          ActivityNotFoundException when the row is tapped.
        -->
        <activity
            android:name=".CategoryActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!--
          adjustResize so the promote/demote bar is pushed up above the soft
          keyboard; those buttons are the whole reason this screen exists on a
          phone, and they must stay reachable while typing.
        -->
        <activity
            android:name=".EditorActivity"
            android:exported="false"
            android:parentActivityName=".ViewerActivity"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
